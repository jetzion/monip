# Postgres connection string (local Docker default shown)
DATABASE_URL=postgres://monip:monip@127.0.0.1:5432/monip

# Signs admin sessions; generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public site URL, used in links inside emails (required in production)
SITE_URL=http://localhost:3000

# Receives a notification for each inquiry (placeholder until MONIP confirms)
INQUIRY_NOTIFY_EMAIL=inquiries@example.com
